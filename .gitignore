# Dependencies
node_modules/

# Environment / secrets — 실제 값이 담긴 파일은 절대 커밋하지 않는다
# (docs/4-project-structure.md 5.1 원칙). .env.example만 커밋 대상.
.env
.env.*
!.env.example

# Build outputs
dist/
build/
out/
.vite/
.turbo/

# backend/swagger/swagger.json은 swagger/swagger.json(SSOT)의 복사본이지만,
# Vercel vercel.json#functions.includeFiles는 빌드 커맨드가 생성한 파일을 포함하지
# 못하고 git 커밋된 파일만 대상으로 하므로 커밋한다(backend/scripts/copy-swagger.js는
# 로컬 개발 시 SSOT와의 동기화용으로 계속 사용 — SSOT 변경 시 재실행 후 재커밋 필요).

# TypeScript incremental build info
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.eslintcache

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Claude Code — 팀 공용 설정(.claude/settings.json, .claude/agents/)은 커밋하되,
# 개인별 로컬 오버라이드(.claude/settings.local.json)는 제외한다.
.claude/settings.local.json

# Temporary files
*.tmp
*.temp
