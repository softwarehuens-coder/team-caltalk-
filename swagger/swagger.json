{
  "openapi": "3.0.3",
  "info": {
    "title": "Team CalTalk API",
    "version": "1.0.0",
    "description": "Team CalTalk 백엔드 REST API 명세.\n\n근거 문서: docs/2-PRD.md (v1.0, UC1-UC9/SC1-SC4), docs/3-User-scenarios.md (v1.0, US-01~US-08), docs/7-erd.md (v1.1, 데이터 모델), docs/5-arch-diagram.md (v1.1, REST/WebSocket 역할 분리), docs/6-tech-stack.md (v1.0, Node.js+TypeScript+Express, PostgreSQL), docs/1-domain-definition.md (v1.4, 4장 권한 SSOT).\n\n범위 안내: 본 문서는 REST(HTTP) API만 다룬다. UC5(캘린더-채팅 연동을 통한 실시간 메시지 송수신)는 별도의 WebSocket 채널로 처리되며 이 OpenAPI 문서의 범위에 포함되지 않는다(docs/5-arch-diagram.md 참조). REST는 팀/일정/변경요청 CRUD와 채팅 이력의 페이지네이션 조회(UC8)만 담당한다.\n\n명명 규칙: DB 컬럼은 snake_case(docs/7-erd.md)이나, 본 API의 JSON 필드명은 REST/JSON 관례에 따라 camelCase로 노출한다(예: DB의 start_at은 JSON의 startAt으로 매핑).",
    "contact": {
      "name": "Team CalTalk"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "로컬 개발 서버 (placeholder)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "System", "description": "헬스 체크" },
    { "name": "Auth", "description": "UC1 로그인/인증" },
    { "name": "Teams", "description": "팀 라이프사이클(생성/초대/가입/탈퇴/팀장 위임) - 도메인 정의서 5장" },
    { "name": "Schedules", "description": "UC2-UC4, UC9 - 팀 일정 조회/생성/수정/삭제" },
    { "name": "Chat", "description": "UC8 - 일정별 채팅 이력 조회(REST). 실시간 송수신(UC5)은 WebSocket 별도 채널" },
    { "name": "ChangeRequests", "description": "UC6, UC7 - 일정 변경 요청 및 승인/거절" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "헬스 체크",
        "description": "서버 기동 상태 확인용 엔드포인트. 인증이 필요 없다.",
        "security": [],
        "responses": {
          "200": {
            "description": "서버가 정상적으로 동작 중",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입",
        "description": "UC1 - 사용자 계정을 생성한다. 인증이 필요 없다. password는 서버에서 해시되어 password_hash로 저장되며 응답에는 절대 포함되지 않는다(docs/7-erd.md USER.password_hash).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "409": {
            "description": "이미 등록된 이메일",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인",
        "description": "UC1 - 이메일/비밀번호로 인증하고 JWT 스타일 액세스 토큰을 발급한다(docs/8-execution-plan.md BE-2). 이후 모든 보호된 엔드포인트는 이 토큰을 Authorization: Bearer 헤더로 전달해야 한다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치 - UC1 인증 실패",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams": {
      "post": {
        "tags": ["Teams"],
        "summary": "팀 생성",
        "description": "도메인 정의서 5장 '팀 생성' - 팀을 최초로 생성한 사용자는 자동으로 해당 팀의 팀장(LEADER) 역할을 부여받는다. US-01.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTeamRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "팀 생성 성공 - 생성자는 LEADER로 등록됨",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Team" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/invite": {
      "post": {
        "tags": ["Teams"],
        "summary": "팀원 초대",
        "description": "도메인 정의서 5장 '팀원 초대/가입' - 팀장은 다른 사용자를 팀원으로 초대할 수 있다. 초대받은 사용자는 이후 POST /teams/{teamId}/join 으로 가입을 완료한다. US-01.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InviteTeamMemberRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "초대 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvitationResponse" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀장이 아닌 사용자의 초대 시도 - 도메인 정의서 4장 권한 규칙(초대는 팀장 전용)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/join": {
      "post": {
        "tags": ["Teams"],
        "summary": "팀 가입",
        "description": "도메인 정의서 5장 '팀원 초대/가입' - 인증된 사용자가 팀에 팀원(MEMBER)으로 가입한다. US-01 3~4단계. docs/8-execution-plan.md BE-4.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" }
        ],
        "responses": {
          "201": {
            "description": "가입 성공 - MEMBER 역할로 TeamMembership 생성",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TeamMembership" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "이미 해당 팀의 구성원인 상태에서 재가입 시도 - 유효하지 않은 상태 전이",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/leave": {
      "post": {
        "tags": ["Teams"],
        "summary": "팀 탈퇴",
        "description": "도메인 정의서 5장 '팀원 탈퇴' 및 '팀 해체' - 탈퇴 시 해당 팀의 일정 조회 및 변경 요청 권한을 상실한다. 유일한 팀장이 위임 없이 탈퇴를 시도하면 팀 해체 규칙 위반으로 거부된다. docs/8-execution-plan.md BE-4.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" }
        ],
        "responses": {
          "200": {
            "description": "탈퇴 성공. 유일한 팀원(팀장)이 탈퇴한 경우 팀이 해체되며 해당 팀의 모든 일정 및 채팅 이력이 함께 삭제된다(도메인 정의서 5장, 6장, SC2 예외)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LeaveTeamResponse" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀 또는 소속 정보를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "유일한 팀장이 다른 팀원에게 위임하지 않은 채 탈퇴를 시도 - 도메인 정의서 5장 '팀 해체' 규칙 위반(위임할 팀원이 있음에도 위임 없이 탈퇴 시도 시 거부)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/delegate-leader": {
      "post": {
        "tags": ["Teams"],
        "summary": "팀장 위임",
        "description": "도메인 정의서 5장 '팀장 위임(영구 이전, 회수 불가)' - 기존 팀장이 다른 팀원에게 팀장 역할을 영구적으로 이전한다. 위임 후 기존 팀장은 MEMBER로 전환된다. 팀은 항상 정확히 1명의 팀장을 가진다(4장 불변조건).",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DelegateLeaderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "위임 성공 - 대상 팀원이 새 LEADER, 기존 팀장은 MEMBER로 전환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TeamMembership" }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀장이 아닌 사용자의 위임 시도 - 도메인 정의서 4장/5장(위임은 팀장 전용)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀 또는 위임 대상 팀원을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "위임 대상이 해당 팀의 팀원이 아니거나 이미 팀장인 상태 - 유효하지 않은 상태 전이",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/schedules": {
      "get": {
        "tags": ["Schedules"],
        "summary": "팀 일정 조회 (월/주/일)",
        "description": "UC2, UC4, SC1 - 기간 제한 없이 팀장/팀원 모두 팀의 전체 일정(과거/현재/미래)을 월/주/일 단위로 조회할 수 있다. docs/8-execution-plan.md BE-5.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" },
          {
            "name": "view",
            "in": "query",
            "required": true,
            "description": "캘린더 조회 단위",
            "schema": {
              "type": "string",
              "enum": ["month", "week", "day"]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "조회 기준 일자 (해당 월/주/일을 포함하는 날짜)",
            "schema": { "type": "string", "format": "date", "example": "2026-09-07" }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Schedule" }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "해당 팀의 구성원이 아닌 사용자의 조회 시도(탈퇴 후 재조회 포함) - 도메인 정의서 5장 '팀원 탈퇴'(탈퇴 시 해당 팀 일정 조회 권한 상실), docs/8-execution-plan.md BE-4 완료조건(탈퇴 후 조회 API 403 검증)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Schedules"],
        "summary": "팀 일정 생성",
        "description": "UC3, UC9, SC3, SC4 - 팀장만 일정을 생성할 수 있다(4장 권한 규칙). 참여자 중 시간대가 겹치는 기존 일정이 있으면 충돌 경고 정보가 함께 반환되나 저장 자체는 차단하지 않는다(SC4). docs/8-execution-plan.md BE-5.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateScheduleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "일정 생성 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ScheduleCreateResponse" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀원(MEMBER)의 일정 생성 시도 - 쓰기 권한은 팀장에게만 있음(UC3, SC3)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/schedules/{id}": {
      "put": {
        "tags": ["Schedules"],
        "summary": "팀 일정 수정",
        "description": "UC3, UC9, SC3, SC4 - 팀장만 일정을 수정할 수 있다. 수정 시에도 참여자 시간대 충돌을 감지하여 경고한다(저장은 차단하지 않음). docs/8-execution-plan.md BE-5.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" },
          { "$ref": "#/components/parameters/ScheduleIdPath" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateScheduleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "일정 수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ScheduleCreateResponse" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀원(MEMBER)의 일정 수정 시도 - 쓰기 권한은 팀장에게만 있음(UC3, SC3)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀 또는 일정을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Schedules"],
        "summary": "팀 일정 삭제 (소프트 삭제)",
        "description": "UC3, SC3 - 팀장만 일정을 삭제할 수 있다. 삭제는 소프트 삭제(deletedAt 설정)로 처리되며, 도메인 정의서 6장에 따라 삭제 후에도 해당 일정에 종속된 채팅 이력(Chat/ChatMessage)은 보존된다(SC2). docs/8-execution-plan.md BE-5.",
        "parameters": [
          { "$ref": "#/components/parameters/TeamIdPath" },
          { "$ref": "#/components/parameters/ScheduleIdPath" }
        ],
        "responses": {
          "204": {
            "description": "일정 삭제(소프트 삭제) 성공"
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀원(MEMBER)의 일정 삭제 시도 - 쓰기 권한은 팀장에게만 있음(UC3, SC3)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "팀 또는 일정을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/schedules/{scheduleId}/messages": {
      "get": {
        "tags": ["Chat"],
        "summary": "일정별 채팅 이력 조회 (페이지네이션)",
        "description": "UC8, SC2 - 일정에 종속된 채팅 이력을 순서대로 페이지네이션하여 조회한다. 실시간 메시지 송신(UC5)은 이 REST 엔드포인트가 아닌 별도의 WebSocket 채널로 처리된다(docs/5-arch-diagram.md, docs/4-project-structure.md chat.routes.ts/chat.gateway.ts 분리). docs/8-execution-plan.md BE-6.",
        "parameters": [
          { "$ref": "#/components/parameters/ScheduleIdPath" },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "이전 응답의 nextCursor 값. 최초 조회 시 생략하면 가장 오래된(또는 최신) 메시지부터 반환한다.",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "페이지당 최대 메시지 수",
            "schema": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedChatMessages" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "해당 일정이 속한 팀의 구성원이 아닌 사용자의 조회 시도 - docs/8-execution-plan.md BE-6 완료조건('팀 비소속 사용자 호출 시 403')",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "일정 또는 채팅을 찾을 수 없음 - 예: 소속 팀이 해체되어 일정/채팅 이력이 함께 삭제된 경우(도메인 정의서 5장/6장, SC2 예외)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/schedules/{scheduleId}/change-requests": {
      "post": {
        "tags": ["ChangeRequests"],
        "summary": "일정 변경 요청 생성",
        "description": "UC6, SC3 - 팀원은 자신과 관련된(참여자로 등록된) 일정에 대해 희망 시작/종료 일시와 사유를 담아 변경을 요청할 수 있다. 요청은 PENDING 상태로 생성되며, 팀장이 승인하기 전까지 원래 일정 정보는 변경되지 않는다. US-04, US-05.",
        "parameters": [
          { "$ref": "#/components/parameters/ScheduleIdPath" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitChangeRequestRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "변경 요청 생성 성공 (status=PENDING)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChangeRequest" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "해당 일정의 참여자가 아닌 사용자의 변경 요청 시도 - '자신과 관련된 일정'으로 한정(도메인 정의서 3장/4장)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "일정을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/change-requests/{id}/approve": {
      "post": {
        "tags": ["ChangeRequests"],
        "summary": "변경 요청 승인",
        "description": "UC7, SC3 - 팀장만 변경 요청을 승인할 수 있다. 승인과 동시에(단일 트랜잭션) 대상 일정의 title/startAt/endAt이 요청된 내용으로 갱신된다(승인 시에만 반영). PENDING 상태가 아닌 요청은 승인할 수 없다. US-04.",
        "parameters": [
          { "$ref": "#/components/parameters/ChangeRequestIdPath" }
        ],
        "responses": {
          "200": {
            "description": "승인 성공 - ChangeRequest.status=APPROVED, 대상 Schedule 갱신됨",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChangeRequest" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀장이 아닌 사용자의 승인 시도 - 승인/거절 권한은 팀장에게만 있음(4장 권한 규칙)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "변경 요청을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "이미 APPROVED 또는 REJECTED로 결정된 요청을 다시 승인하려는 시도 - 유효하지 않은 상태 전이(PENDING이 아닌 ChangeRequest는 승인 불가)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/change-requests/{id}/reject": {
      "post": {
        "tags": ["ChangeRequests"],
        "summary": "변경 요청 거절",
        "description": "UC7, SC2, SC3 - 팀장만 변경 요청을 거절할 수 있다. 거절 시 원래 일정 정보는 그대로 유지되며, 사유는 해당 일정의 채팅을 통해 팀원에게 통지되고 팀원은 재요청할 수 있다(US-05). PENDING 상태가 아닌 요청은 거절할 수 없다.",
        "parameters": [
          { "$ref": "#/components/parameters/ChangeRequestIdPath" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RejectChangeRequestRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "거절 성공 - ChangeRequest.status=REJECTED, 원래 Schedule은 변경되지 않음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChangeRequest" }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청 - UC1",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "팀장이 아닌 사용자의 거절 시도 - 승인/거절 권한은 팀장에게만 있음(4장 권한 규칙)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "변경 요청을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "이미 APPROVED 또는 REJECTED로 결정된 요청을 다시 거절하려는 시도 - 유효하지 않은 상태 전이(PENDING이 아닌 ChangeRequest는 거절 불가)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "UC1 인증 - /auth/login에서 발급된 토큰을 Authorization: Bearer {token} 헤더로 전달한다. /health, /auth/register, /auth/login을 제외한 모든 엔드포인트에 필요하다."
      }
    },
    "parameters": {
      "TeamIdPath": {
        "name": "teamId",
        "in": "path",
        "required": true,
        "description": "팀 ID",
        "schema": { "type": "string" }
      },
      "ScheduleIdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "일정 ID",
        "schema": { "type": "string" }
      },
      "ChangeRequestIdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "변경 요청 ID",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "description": "docs/8-execution-plan.md BE-1 완료조건 - GET /health는 200과 함께 DB 연결 상태를 반환해야 한다",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "database": {
            "type": "string",
            "description": "PostgreSQL 커넥션 풀 헬스체크(SELECT 1) 결과 상태",
            "enum": ["connected", "disconnected"],
            "example": "connected"
          }
        },
        "required": ["status", "database"]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "모든 오류 응답에 공통으로 사용되는 형식",
        "properties": {
          "code": {
            "type": "string",
            "description": "기계 판독 가능한 오류 코드",
            "example": "UNAUTHENTICATED"
          },
          "message": {
            "type": "string",
            "description": "사람이 읽을 수 있는 오류 설명",
            "example": "인증 토큰이 유효하지 않습니다."
          }
        },
        "required": ["code", "message"]
      },
      "User": {
        "type": "object",
        "description": "docs/7-erd.md USER 엔티티 (password_hash는 절대 노출하지 않음)",
        "properties": {
          "id": { "type": "string", "example": "usr_01hz" },
          "email": { "type": "string", "format": "email", "example": "jihoon@example.com" },
          "name": { "type": "string", "example": "지훈" }
        },
        "required": ["id", "email", "name"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "jihoon@example.com" },
          "name": { "type": "string", "example": "지훈" },
          "password": { "type": "string", "format": "password", "minLength": 8, "example": "S3curePass!" }
        },
        "required": ["email", "name", "password"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "jihoon@example.com" },
          "password": { "type": "string", "format": "password", "example": "S3curePass!" }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "JWT 스타일 액세스 토큰", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["token", "user"]
      },
      "Team": {
        "type": "object",
        "description": "docs/7-erd.md TEAM 엔티티",
        "properties": {
          "id": { "type": "string", "example": "team_01hz" },
          "name": { "type": "string", "example": "디자인팀" }
        },
        "required": ["id", "name"]
      },
      "CreateTeamRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "디자인팀" }
        },
        "required": ["name"]
      },
      "TeamMembership": {
        "type": "object",
        "description": "docs/7-erd.md TEAM_MEMBERSHIP 엔티티. role: LEADER(팀장) / MEMBER(팀원)",
        "properties": {
          "id": { "type": "string", "example": "mem_01hz" },
          "teamId": { "type": "string", "example": "team_01hz" },
          "userId": { "type": "string", "example": "usr_01hz" },
          "role": { "type": "string", "enum": ["LEADER", "MEMBER"], "example": "MEMBER" }
        },
        "required": ["id", "teamId", "userId", "role"]
      },
      "InviteTeamMemberRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "description": "초대할 사용자의 이메일", "example": "seoyeon@example.com" }
        },
        "required": ["email"]
      },
      "InvitationResponse": {
        "type": "object",
        "properties": {
          "teamId": { "type": "string", "example": "team_01hz" },
          "email": { "type": "string", "format": "email", "example": "seoyeon@example.com" },
          "message": { "type": "string", "example": "초대가 발송되었습니다. 대상 사용자는 로그인 후 POST /teams/{teamId}/join으로 가입을 완료해야 합니다." }
        },
        "required": ["teamId", "email"]
      },
      "LeaveTeamResponse": {
        "type": "object",
        "properties": {
          "teamId": { "type": "string", "example": "team_01hz" },
          "teamDissolved": {
            "type": "boolean",
            "description": "유일한 팀장(=유일한 팀원)이 탈퇴하여 팀이 해체되었는지 여부. true인 경우 해당 팀의 모든 일정 및 채팅 이력이 함께 삭제되었음(도메인 정의서 5장, 6장, SC2 예외)",
            "example": false
          }
        },
        "required": ["teamId", "teamDissolved"]
      },
      "DelegateLeaderRequest": {
        "type": "object",
        "properties": {
          "newLeaderUserId": { "type": "string", "description": "새로 팀장이 될 팀원의 사용자 ID", "example": "usr_02hz" }
        },
        "required": ["newLeaderUserId"]
      },
      "Schedule": {
        "type": "object",
        "description": "docs/7-erd.md SCHEDULE 엔티티. deletedAt이 null이 아니면 소프트 삭제된 일정(채팅 이력은 보존됨)",
        "properties": {
          "id": { "type": "string", "example": "sch_01hz" },
          "teamId": { "type": "string", "example": "team_01hz" },
          "title": { "type": "string", "example": "주간 정기 회의" },
          "startAt": { "type": "string", "format": "date-time", "example": "2026-09-08T10:00:00+09:00" },
          "endAt": { "type": "string", "format": "date-time", "example": "2026-09-08T11:00:00+09:00" },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "소프트 삭제 시각. 삭제되지 않았으면 null",
            "example": null
          },
          "participants": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScheduleParticipant" }
          }
        },
        "required": ["id", "teamId", "title", "startAt", "endAt", "deletedAt"]
      },
      "ScheduleParticipant": {
        "type": "object",
        "description": "docs/7-erd.md SCHEDULE_PARTICIPANT 엔티티",
        "properties": {
          "id": { "type": "string", "example": "par_01hz" },
          "scheduleId": { "type": "string", "example": "sch_01hz" },
          "userId": { "type": "string", "example": "usr_02hz" }
        },
        "required": ["id", "scheduleId", "userId"]
      },
      "CreateScheduleRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "주간 정기 회의" },
          "startAt": { "type": "string", "format": "date-time", "example": "2026-09-08T10:00:00+09:00" },
          "endAt": { "type": "string", "format": "date-time", "example": "2026-09-08T11:00:00+09:00" },
          "participantUserIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "참여자로 등록할 사용자 ID 목록",
            "example": ["usr_02hz", "usr_03hz"]
          }
        },
        "required": ["title", "startAt", "endAt", "participantUserIds"]
      },
      "UpdateScheduleRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "주간 정기 회의(변경)" },
          "startAt": { "type": "string", "format": "date-time", "example": "2026-09-08T10:30:00+09:00" },
          "endAt": { "type": "string", "format": "date-time", "example": "2026-09-08T11:30:00+09:00" },
          "participantUserIds": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["usr_02hz", "usr_03hz"]
          }
        },
        "required": ["title", "startAt", "endAt", "participantUserIds"]
      },
      "ScheduleConflictWarning": {
        "type": "object",
        "description": "UC9, SC4 - 참여자 시간대가 겹치는 기존 일정에 대한 경고 정보. 저장 자체를 차단하지 않는 참고 정보",
        "properties": {
          "conflictingScheduleId": { "type": "string", "example": "sch_00aa" },
          "conflictingUserId": { "type": "string", "example": "usr_02hz" },
          "conflictingScheduleTitle": { "type": "string", "example": "고객사 미팅" }
        },
        "required": ["conflictingScheduleId", "conflictingUserId", "conflictingScheduleTitle"]
      },
      "ScheduleCreateResponse": {
        "type": "object",
        "description": "UC9/SC4 - 생성/수정된 일정과 함께 참여자 시간 충돌 경고(있는 경우)를 반환한다",
        "properties": {
          "schedule": { "$ref": "#/components/schemas/Schedule" },
          "conflictWarnings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScheduleConflictWarning" },
            "description": "빈 배열이면 충돌 없음"
          }
        },
        "required": ["schedule", "conflictWarnings"]
      },
      "Chat": {
        "type": "object",
        "description": "docs/7-erd.md CHAT 엔티티 - 일정과 1:1 관계",
        "properties": {
          "id": { "type": "string", "example": "chat_01hz" },
          "scheduleId": { "type": "string", "example": "sch_01hz" }
        },
        "required": ["id", "scheduleId"]
      },
      "ChatMessage": {
        "type": "object",
        "description": "docs/7-erd.md CHAT_MESSAGE 엔티티",
        "properties": {
          "id": { "type": "string", "example": "msg_01hz" },
          "chatId": { "type": "string", "example": "chat_01hz" },
          "senderUserId": { "type": "string", "example": "usr_02hz" },
          "content": { "type": "string", "example": "오후에 다른 미팅이 있어 30분 정도 늦을 수도 있을 것 같습니다" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-09-07T09:15:00+09:00" }
        },
        "required": ["id", "chatId", "senderUserId", "content", "createdAt"]
      },
      "PaginatedChatMessages": {
        "type": "object",
        "description": "UC8 - 커서 기반 페이지네이션 응답. 채팅 이력은 기간 제한 없이 누적되므로(SC2) 점진적 조회를 기본값으로 한다(docs/4-project-structure.md 5.4)",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "다음 페이지 조회에 사용할 커서. 더 이상 조회할 메시지가 없으면 null"
          },
          "hasMore": { "type": "boolean" }
        },
        "required": ["data", "nextCursor", "hasMore"]
      },
      "ChangeRequest": {
        "type": "object",
        "description": "docs/7-erd.md CHANGE_REQUEST 엔티티. status: PENDING/APPROVED/REJECTED. desiredStartAt/desiredEndAt은 UC6(희망 시작/종료일시 포함 요청)·UC7(승인 시 해당 값으로 Schedule 갱신)에 대응하며, docs/7-erd.md v1.2 및 database/schema.sql v1.2의 change_requests.desired_start_at/desired_end_at 컬럼과 일치한다(이전 감사에서 발견된 ERD/DDL 간극은 해소됨).",
        "properties": {
          "id": { "type": "string", "example": "cr_01hz" },
          "scheduleId": { "type": "string", "example": "sch_01hz" },
          "requestedByUserId": { "type": "string", "example": "usr_02hz" },
          "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"], "example": "PENDING" },
          "desiredStartAt": { "type": "string", "format": "date-time", "example": "2026-09-08T10:30:00+09:00" },
          "desiredEndAt": { "type": "string", "format": "date-time", "example": "2026-09-08T11:30:00+09:00" },
          "reason": { "type": "string", "example": "오후에 다른 일정이 생겨 30분 늦게 시작하고 싶습니다." },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-09-07T09:20:00+09:00" },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "승인/거절 시각. PENDING인 동안 null(docs/7-erd.md)",
            "example": null
          }
        },
        "required": ["id", "scheduleId", "requestedByUserId", "status", "desiredStartAt", "desiredEndAt", "reason", "createdAt", "decidedAt"]
      },
      "SubmitChangeRequestRequest": {
        "type": "object",
        "description": "UC6 - 팀원이 채팅을 통해 담아 보내는 희망 시작/종료 일시와 사유",
        "properties": {
          "desiredStartAt": { "type": "string", "format": "date-time", "example": "2026-09-08T10:30:00+09:00" },
          "desiredEndAt": { "type": "string", "format": "date-time", "example": "2026-09-08T11:30:00+09:00" },
          "reason": { "type": "string", "example": "오후에 다른 일정이 생겨 30분 늦게 시작하고 싶습니다." }
        },
        "required": ["desiredStartAt", "desiredEndAt", "reason"]
      },
      "RejectChangeRequestRequest": {
        "type": "object",
        "description": "UC7 - 거절 사유는 채팅을 통해 요청자에게 통지된다",
        "properties": {
          "reason": { "type": "string", "example": "다른 참여자의 일정과 겹쳐 반영이 어렵습니다." }
        },
        "required": ["reason"]
      }
    }
  }
}
