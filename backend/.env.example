# PostgreSQL 연결 문자열 (필수). database/schema.sql이 적용된 인스턴스를 가리켜야 한다.
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/team_caltalk

# HTTP 서버 포트 (선택, 기본값 3001)
PORT=3001

# JWT 서명 키 (필수, BE-2). 절대 커밋하지 않는다 — 실제 값은 .env에만 둔다.
JWT_SECRET=change-me-in-local-env

# CORS 허용 origin (선택, 콤마로 여러 개 지정 가능). 프론트엔드와 백엔드가 다른 도메인에
# 배포될 때만 필요하다(예: Vercel). 로컬 개발은 vite.config.ts 프록시로 우회하므로 불필요.
CORS_ORIGIN=https://team-caltalk-frontend2.vercel.app

